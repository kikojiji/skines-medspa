{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/send-tirage.js": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/fonts/**"
    },
    "api/send-gift-card.js": {
      "includeFiles": "api/_lib/fonts/**"
    }
  },
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    }
  ]
}
