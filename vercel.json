{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/send-tirage.js": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/fonts/**"
    },
    "api/send-gift-card.js": {
      "includeFiles": "api/_lib/fonts/**"
    }
  },
  "redirects": [
    {
      "source": "/web",
      "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/tiktok",
      "destination": "/?utm_source=tiktok&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.skines.ca" }],
      "destination": "https://skines.ca/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.skines.ca" }],
      "destination": "https://skines.ca/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    }
  ]
}
